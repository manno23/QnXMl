# QnXMl development environment (direnv).
# Usage: `direnv allow` once, or `source .envrc` in bash/zsh.
# Sets: opam switch (ocaml-base-compiler.5.3.0) + QNX SDP 8.0 (aarch64le).

# --- opam switch -----------------------------------------------------------
OPAM_SWITCH="${OPAM_SWITCH:-ocaml-base-compiler.5.3.0}"
export OPAMSWITCH="$OPAM_SWITCH"
eval "$(opam env --switch="$OPAM_SWITCH" --set-switch 2>/dev/null)"

# --- QNX SDP 8.0 -------------------------------------------------------------
QNX_BASE="${QNX_BASE:-$HOME/data/qnx/qnx_custom_builds/qnx800}"
export QNX_BASE
export QNX_HOST="$QNX_BASE/host/linux/x86_64"
export QNX_TARGET="$QNX_BASE/target/qnx"
export QNX_CONFIGURATION_EXCLUSIVE="$HOME/.qnx"
export QNX_CONFIGURATION="$QNX_CONFIGURATION_EXCLUSIVE"
# QNX make include path so target headers resolve.
export MAKEFLAGS="-I$QNX_TARGET/usr/include${MAKEFLAGS:+ $MAKEFLAGS}"
export PYTHONDONTWRITEBYTECODE=1

# Prepend QNX host tools (qcc, ntoaarch64-*) if present.
if [ -d "$QNX_HOST/usr/bin" ]; then
  PATH="$QNX_HOST/usr/bin:$QNX_CONFIGURATION/bin:$QNX_BASE/jre/bin:$QNX_BASE/host/common/bin:$PATH"
fi
export PATH

# Convenience: where the qcc-compiled stub object lands in smoke tests.
export QNXML_QNX_TARGET_TRIPLE="aarch64-unknown-nto-qnx8.0.0"
