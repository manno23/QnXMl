; The library keeps its historical flat module names (Region, Ring, ...)
; via (wrapped false) so test.ml and downstream code need no Qnxml. prefix.
(library
 (name qnxml)
 (public_name qnx_ocaml)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names region_stubs))
 (c_library_flags
  (:include link_flags.sexp)))

; librt exists only on Linux (and is a no-op shim on glibc >= 2.34);
; QNX puts shm_open/mlock in libc, and linking -lrt there fails.
(rule
 (with-stdout-to
  link_flags.sexp
  (bash "case %{system} in linux*) echo '(-lrt)';; *) echo '()';; esac")))
